# Shared secret. Must match AI_SERVICE_KEY in the Laravel .env
AI_SERVICE_KEY=change-me-to-a-long-random-string

# Where ChromaDB stores vectors
DATA_DIR=./data

# Embeddings (local, multilingual: handles English, Filipino, Taglish)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Retrieval. If the best chunk scores below SIMILARITY_THRESHOLD the LLM is NOT called.
# Tune this with your own lectures (see README).
SIMILARITY_THRESHOLD=0.30
TOP_K=5

# Chunking (words, approximates tokens)
CHUNK_WORDS=300
CHUNK_OVERLAP=40
CHUNK_MIN_WORDS=60

# LLM: anthropic or gemini
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# OCR for scanned PDFs and images (needs the Tesseract program installed)
OCR_ENABLED=true
OCR_LANG=eng

MAX_UPLOAD_MB=25
